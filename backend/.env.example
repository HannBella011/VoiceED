# VoiceED Backend Environment Configuration
# Copy this to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/voiceed
# Alternative for Firebase (future): FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API
API_V1_PREFIX=/api/v1
PROJECT_NAME=VoiceED API
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# Email (future)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=VoiceED