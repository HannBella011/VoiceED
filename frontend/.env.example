# VoiceED Frontend Environment Configuration
# Copy this to .env.local and fill in your values

# Supabase Configuration (Client-side)
# Get from Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Set the public API URL before building for production.
# NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# Google OAuth (configured in Supabase Dashboard > Authentication > Providers > Google)
# No additional env vars needed here - configured in Supabase project settings